<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExerciciosPadraoMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExerciciosPadraoMVC.styles.css" asp-append-version="true" />
</head>

<body>
    <nav>
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <a asp-controller="Evento" asp-action="Index">Eventos</a>
        <a asp-controller="Evento" asp-action="Criar">Novo Evento</a>
    </nav>
    <hr/>

    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
